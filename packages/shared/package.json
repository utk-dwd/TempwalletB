{
  "name": "@tempwallet/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    },
    "./networks": {
      "types": "./dist/networks.d.ts",
      "import": "./dist/networks.js",
      "require": "./dist/networks.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "postinstall": "tsc -b || true"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}